<div class="modal fade" id="modalDetallePokemon" tabindex="-1" aria-labelledby="modalDetallePokemonLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalDetallePokemonLabel">Detalles</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-iv/heartgold-soulsilver/1.png"
                                 alt="{Pokemon}" width="100" height="100" />
                        </div>
                        <div class="col">
                            <label for="formDetalleNombre" class="form-label">Nombre:</label>
                            <input class="form-control" id="formDetalleNombre" value="Bulbasaur" readonly>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="form-label">Tipo:</label>
                            <br />
                            <span class="badge text-bg-light">Planta</span>
                            <span class="badge text-bg-light">Veneno</span>
                        </div>
                        <div class="col">
                            <label for="formDetalleNumero" class="form-label"># Pokedex:</label>
                            <input class="form-control" id="formDetalleNumero" value="1" readonly>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label for="formDetalleAltura" class="form-label">Altura:</label>
                            <input class="form-control" id="formDetalleAltura" value="7" readonly>
                        </div>
                        <div class="col">
                            <label for="formDetallePeso" class="form-label">Peso:</label>
                            <input class="form-control" id="formDetallePeso" value="69 hg" readonly>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalDetallePokemon" tabindex="-1" aria-labelledby="modalDetallePokemonLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalDetallePokemonLabel">Detalles</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="loadingSpinner" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando información...</p>
                </div>

                <div id="modalContent" class="container">
                    <div class="row">
                        <div class="col">
                            <img id="imgDetalleSprite" src="" alt="sprite" width="100" height="100" />
                        </div>
                        <div class="col">
                            <label for="formDetalleNombre" class="form-label">Nombre:</label>
                            <input class="form-control" id="formDetalleNombre" value="" readonly>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="form-label">Tipo:</label>
                            <br />
                            <div id="modalTypesContainer"></div>
                        </div>
                        <div class="col">
                            <label for="formDetalleNumero" class="form-label"># Pokedex:</label>
                            <input class="form-control" id="formDetalleNumero" readonly>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label for="formDetalleAltura" class="form-label">Altura:</label>
                            <input class="form-control" id="formDetalleAltura" readonly>
                        </div>
                        <div class="col">
                            <label for="formDetallePeso" class="form-label">Peso:</label>
                            <input class="form-control" id="formDetallePeso" readonly>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@model ScisaPokeApi.Models.PokemonIndexViewModel

<div class="container">
    <form method="get" asp-action="Index">
        <div class="row pb-3">
            <div class="col-sm-6 col-md-3">
                <label for="nombrePkmn" class="form-label">Nombre:</label>
                <input class="form-control" id="nombrePkmn" placeholder="Agumon" name="searchTerm"
                       value="@Model.SearchTerm">
            </div>
            <div class="col-sm-6 col-md-3">
                <label for="especiePkmn" class="form-label">Especie:</label>
                <select class="form-select" id="especiePkmn" name="selectedSpecie">
                    <option value="0">-Todos-</option>
                    @foreach (var especie in Model.AvailableSpecies)
                    {
                        <option value="@especie.Name"
                                selected="@(especie.Name == Model.SelectedSpecie ? "selected" : null)">
                            @especie.DisplayName
                        </option>
                    }
                </select>
            </div>
        </div>
        <div class="row pb-3">
            <div class="d-grid gap-2 col-sm-6 col-md-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Buscar</button>
            </div>
            <div class="d-grid gap-2 col-sm-6 col-md-3">
                <a class="btn btn-success" asp-action="ExportToExcel" asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-selectedSpecie="@Model.SelectedSpecie" asp-route-page="@Model.PageNumber"
                   data-bs-toggle="tooltip" data-bs-placement="top" title="Exportar los Pokémon filtrados a Excel">
                    <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
                </a>
            </div>
            <div class="d-grid gap-2 col-sm-6 col-md-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal"
                        data-bs-target="#modalEnviarCorreo" data-tipo="general" title="Enviar catálogo filtrado por correo">
                    <i class="bi bi-envelope"></i> Enviar por Correo
                </button>
            </div>
        </div>
    </form>
</div>
@model ScisaPokeApi.Models.PokemonIndexViewModel

<div class="container">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Imagen</th>
                <th scope="col">Nombre</th>
                <th scope="col">Correo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (PokemonDto pokemon in Model.Pokemons)
            {
                <tr data-bs-toggle="modal" data-bs-target="#modalDetallePokemon" data-id="@pokemon.Id"
                    data-nombre="@pokemon.Name">
                    <th scope="row"></th>
                    <td>
                        <img src="@pokemon.ImageUrl" alt="@pokemon.Name img" width="100" height="100" />
                    </td>
                    <td>@pokemon.Name</td>
                    <td>
                        <button type="button" class="btn btn-outline-secondary btn-enviar-individual" data-bs-toggle="modal"
                                data-bs-target="#modalEnviarCorreo" data-tipo="individual" data-id="@pokemon.Id"
                                title="Enviar este Pokémon por correo">
                            <i class="bi bi-envelope"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="container d-flex justify-content-between align-items-center mt-4">
        <a class="btn btn-secondary @(!Model.HasPreviousPage ? "disabled" : "")" asp-action="Index"
           asp-route-page="@(Model.PageNumber - 1)" asp-route-searchTerm="@Model.SearchTerm"
           asp-route-selectedSpecie="@Model.SelectedSpecie">
            <i class="bi bi-chevron-left"></i> Anterior
        </a>

        <label>Página @Model.PageNumber de @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</label>

        <a class="btn btn-secondary @(!Model.HasNextPage ? "disabled" : "")" asp-action="Index"
           asp-route-page="@(Model.PageNumber + 1)" asp-route-searchTerm="@Model.SearchTerm"
           asp-route-selectedSpecie="@Model.SelectedSpecie">
            Siguiente <i class="bi bi-chevron-right"></i>
        </a>
    </div>
</div>